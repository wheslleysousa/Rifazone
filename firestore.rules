rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // RifaZone é multi-organizador. TODA escrita passa pelo backend
    // (Admin SDK, que ignora estas regras). O cliente nunca escreve direto.
    // Aqui liberamos apenas as LEITURAS públicas que a página da campanha precisa.

    // Campanhas: leitura pública (página /c/{codigo}); escrita só pelo backend.
    match /campanhas/{campanhaId} {
      allow read: if true;
      allow write: if false;

      // Cotas: leitura pública (mostrar ocupadas/vendidas); escrita só backend.
      match /cotas/{cotaId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Pedidos: nada de acesso público direto. Consulta de status é feita
    // por endpoint do backend, não pelo cliente lendo o Firestore.
    match /pedidos/{pedidoId} {
      allow read, write: if false;
    }

    // Compradores: dados pessoais — sem acesso público direto.
    match /compradores/{compradorId} {
      allow read, write: if false;
    }

    // Doc de teste de conexão do SDK Firebase no boot do frontend.
    match /test/{docId} {
      allow read: if true;
    }
  }
}
