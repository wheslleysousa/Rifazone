# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BASE_URL: Public URL of the app (used for Mercado Pago webhook notification_url & OAuth callback)
BASE_URL="MY_APP_URL"

# MP_CLIENT_ID: Mercado Pago Application ID (Client ID) para conexão OAuth dos organizadores em 1 clique
MP_CLIENT_ID=""

# MP_CLIENT_SECRET: Mercado Pago Client Secret para validação do OAuth dos organizadores
MP_CLIENT_SECRET=""

# MP_ACCESS_TOKEN: Mercado Pago Production or Test Access Token (APP_USR-... or TEST-...)
MP_ACCESS_TOKEN=""

# MP_WEBHOOK_SECRET: Webhook signature validation secret from Mercado Pago portal
MP_WEBHOOK_SECRET=""

# --- Autenticação (Firebase Authentication) ---
# O login/cadastro dos organizadores é feito via Firebase Auth (Google + email/senha).
# O backend valida o ID Token do Firebase usando as chaves públicas do Google.
# O projectId é lido de firebase-applet-config.json; sobrescreva aqui se necessário:
# FIREBASE_PROJECT_ID="rifazone"

# AUTH_DEV_BYPASS: SOMENTE PARA DESENVOLVIMENTO. Se "true", o backend NÃO valida
# a assinatura do token (apenas decodifica). NUNCA use em produção.
AUTH_DEV_BYPASS="false"

# --- Banco de dados (Firestore via Firebase Admin) ---
# Sem estas credenciais o app usa armazenamento em ARQUIVO local (só dev).
# Com elas, usa o FIRESTORE (dados reais e persistentes).
# FIREBASE_SERVICE_ACCOUNT: cole o JSON completo da service account (uma linha),
# ou o caminho para o arquivo .json. Gere em:
# Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave.
FIREBASE_SERVICE_ACCOUNT=""
# FIRESTORE_DATABASE_ID: opcional. Por padrão é lido de firebase-applet-config.json.
# FIRESTORE_DATABASE_ID=""

# CRON_SECRET: Segredo para proteger o endpoint de expiração ativa (POST /api/tarefas/expirar-pedidos)
# Usado por Render Cron Job, Cloud Scheduler, GitHub Actions ou UptimeRobot.
CRON_SECRET="rifazone_cron_secret_default"

# PORT: injetada automaticamente pelo Render/Cloud Run. Localmente usa 3000.
# PORT=3000

