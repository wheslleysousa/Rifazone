# ============================================================================
# Configurações do RifaZone WhatsApp Worker
# ============================================================================
PORT=3001

# URL da sua aplicação RifaZone (no Render ou domínio personalizado)
# Exemplos: https://rifazone.onrender.com ou http://localhost:3000
RIFAZONE_URL=https://rifazone.onrender.com

# Chaves de segurança (devem ser EXATAMENTE IGUAIS às configuradas no Render/App)
# NOTA: Se a sua senha começar com '#' ou contiver caracteres especiais, SEMPRE use aspas duplas!
CRON_SECRET="#1019808782Ab"
WORKER_SECRET="#1019808782Ab"

# Caminho da sessão do WhatsApp (use sempre relativo para evitar erro de permissão no Termux)
DATA_PATH=./session_data

# Caminho do Chromium (no Termux Android é detectado automaticamente, mas pode definir se quiser):
PUPPETEER_EXECUTABLE_PATH=/data/data/com.termux/files/usr/bin/chromium

