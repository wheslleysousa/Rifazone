# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BASE_URL: Public URL of the app (used for Mercado Pago webhook notification_url)
BASE_URL="MY_APP_URL"

# MP_ACCESS_TOKEN: Mercado Pago Production or Test Access Token (APP_USR-... or TEST-...)
MP_ACCESS_TOKEN=""

# MP_WEBHOOK_SECRET: Webhook signature validation secret from Mercado Pago portal
MP_WEBHOOK_SECRET=""

# ADMIN_EMAILS: Comma-separated list of emails authorized to access the /admin panel
ADMIN_EMAILS="wheslleyaviz@gmail.com,admin@exemplo.com"

# ADMIN_PASSWORD: Plaintext password or secret key for admin login fallback
ADMIN_PASSWORD="admin"

