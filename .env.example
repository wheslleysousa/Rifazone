# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BASE_URL: Public URL of the app (used for Mercado Pago webhook notification_url & OAuth callback)
BASE_URL="MY_APP_URL"

# MP_CLIENT_ID: Mercado Pago Application ID (Client ID) para conexão OAuth dos organizadores em 1 clique
MP_CLIENT_ID=""

# MP_CLIENT_SECRET: Mercado Pago Client Secret para validação do OAuth dos organizadores
MP_CLIENT_SECRET=""

# MP_ACCESS_TOKEN: Mercado Pago Production or Test Access Token (APP_USR-... or TEST-...)
MP_ACCESS_TOKEN=""

# MP_WEBHOOK_SECRET: Webhook signature validation secret from Mercado Pago portal
MP_WEBHOOK_SECRET=""

# --- Autenticação (Firebase Authentication) ---
# O login/cadastro dos organizadores é feito via Firebase Auth (Google + email/senha).
# O backend valida o ID Token do Firebase usando as chaves públicas do Google.
# O projectId é lido de firebase-applet-config.json; sobrescreva aqui se necessário:
# FIREBASE_PROJECT_ID="rifazone"

# AUTH_DEV_BYPASS: SOMENTE PARA DESENVOLVIMENTO. Se "true", o backend NÃO valida
# a assinatura do token (apenas decodifica). NUNCA use em produção.
AUTH_DEV_BYPASS="false"

# --- Banco de dados (Firestore via Firebase Admin) ---
# Sem estas credenciais o app usa armazenamento em ARQUIVO local (só dev).
# Com elas, usa o FIRESTORE (dados reais e persistentes).
# FIREBASE_SERVICE_ACCOUNT: cole o JSON completo da service account (uma linha),
# ou o caminho para o arquivo .json. Gere em:
# Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave.
FIREBASE_SERVICE_ACCOUNT=""
# FIRESTORE_DATABASE_ID: opcional. Por padrão é lido de firebase-applet-config.json.
# FIRESTORE_DATABASE_ID=""

# CRON_SECRET: Segredo obrigatório para proteger o endpoint de expiração ativa e remarketing (POST /api/tarefas/*).
# Defina um hash forte. Sem essa variável, as tarefas agendadas retornarão status 503.
CRON_SECRET=""

# WORKER_SECRET: Segredo obrigatório para proteger a integração com o WhatsApp Worker externo (POST /api/worker/*).
# Defina um hash forte. Sem essa variável, os endpoints de integração com o worker retornarão status 503.
WORKER_SECRET=""

# Configurações de SMTP para envio de e-mails usando Gmail ou outro servidor SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""

# PORT: injetada automaticamente pelo Render/Cloud Run. Localmente usa 3000.
# PORT=3000

# EFI_CLIENT_ID: Client ID da Efí Pay (Gerencianet) Produção
EFI_CLIENT_ID=""

# EFI_CLIENT_SECRET: Client Secret da Efí Pay Produção
EFI_CLIENT_SECRET=""

# EFI_CHAVE_PIX: Chave Pix cadastrada na Efí Pay (CPF, CNPJ, E-mail, Celular ou Aleatória)
EFI_CHAVE_PIX=""

# EFI_CLIENT_ID_HOMOLOGACAO: Client ID da Efí Pay Homologação (Testes)
EFI_CLIENT_ID_HOMOLOGACAO=""

# EFI_CLIENT_SECRET_HOMOLOGACAO: Client Secret da Efí Pay Homologação (Testes)
EFI_CLIENT_SECRET_HOMOLOGACAO=""

# EFI_CHAVE_PIX_HOMOLOGACAO: Chave Pix cadastrada na Efí Pay Homologação
EFI_CHAVE_PIX_HOMOLOGACAO=""

# EFI_AMBIENTE: Ambiente ativo da Efí Pay ('producao' ou 'homologacao')
EFI_AMBIENTE="producao"

# EFI_CERTIFICADO_BASE64: Conteúdo em Base64 do certificado .p12 / .pem da Efí Pay
EFI_CERTIFICADO_BASE64=""

# Cloudinary (Configuração Opcional para upload de imagens sem o plano Blaze do Firebase)
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

