# Configurações do RifaZone WhatsApp Worker
PORT=3001

# URL da sua plataforma RifaZone (ex: https://rifazone.com.br)
RIFAZONE_URL=http://localhost:3000

# Chaves de segurança (Devem ser iguais às configuradas no servidor principal)
CRON_SECRET=sua_chave_secreta_aqui
WORKER_SECRET=outra_chave_secreta_aqui

# Caminho para salvar a sessão do WhatsApp (Pasta local ou volume)
DATA_PATH=./session_data

# (Opcional) Caminho do executável do Chrome se estiver no Linux/Docker
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
